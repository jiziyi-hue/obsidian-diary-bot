{
  "name": "ai-diary-bot",
  "version": "1.0.0",
  "description": "Chat with AI on Telegram, auto-save reflections to your Obsidian daily note.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:fast": "node esbuild.config.mjs production",
    "deploy": "npm run build && node tools/deploy.js",
    "test": "tsx --test tests/dateUtils.test.ts tests/markdownUtils.test.ts tests/retryUtils.test.ts"
  },
  "keywords": [
    "obsidian-plugin",
    "telegram",
    "diary",
    "journal",
    "ai"
  ],
  "author": "jiziyi-hue",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "fastest-levenshtein": "^1.0.16",
    "uplot": "^1.6.32"
  }
}
